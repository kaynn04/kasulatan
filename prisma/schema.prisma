generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  mobileNumber      String?
  passwordHash      String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdAgreements Agreement[]      @relation("createdAgreements")
  agreementParties  AgreementParty[]
  auditLogs         AuditLog[]
}

model Agreement {
  id              String           @id @default(cuid())
  referenceNumber String           @unique
  createdById     String
  agreementType   AgreementType
  title           String
  subjectMatter   String
  amount          Decimal
  currency        String
  paymentTerms    String
  dueDate         DateTime?
  termsText       String
  status          AgreementStatus  @default(DRAFT)
  serviceFee      Decimal
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User             @relation("createdAgreements", fields: [createdById], references: [id])
  parties         AgreementParty[]
  auditLogs       AuditLog[]
}

model AgreementParty {
  id                             String             @id @default(cuid())
  agreementId                    String
  userId                         String?
  role                           AgreementPartyRole
  fullName                       String
  email                          String
  mobileNumber                   String?
  address                        String?
  typedSignature                 String?
  consentedToElectronicSignature Boolean            @default(false)
  confirmedReadAgreement         Boolean            @default(false)
  signedAt                       DateTime?
  ipAddress                      String?
  userAgent                      String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  agreement                      Agreement          @relation(fields: [agreementId], references: [id])
  user                           User?              @relation(fields: [userId], references: [id])
}

enum AgreementType {
  LOAN
  SALE
  SWAP
  SERVICE
}

enum AgreementStatus {
  DRAFT
  SENT_TO_COUNTERPARTY
  VIEWED_BY_COUNTERPARTY
  SIGNED_BY_CREATOR
  SIGNED_BY_COUNTERPARTY
  AWAITING_PAYMENT
  FINALIZED
  CANCELLED
  EXPIRED
}

enum AgreementPartyRole {
  CREATOR
  COUNTERPARTY
}

model AuditLog {
  id           String   @id @default(cuid())
  agreementId  String
  actorUserId  String
  actorEmail   String
  action       String
  ipAddress    String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id])
  actor     User      @relation(fields: [actorUserId], references: [id])
}
